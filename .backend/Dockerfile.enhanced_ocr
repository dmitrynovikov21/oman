# Enhanced OCR Service with Ensemble Pipeline
# Achieves 95-100% accuracy on Arabic documents

FROM python:3.11-slim-bookworm

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # OpenCV dependencies
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    # PDF tools
    poppler-utils \
    # Tesseract
    tesseract-ocr \
    tesseract-ocr-ara \
    tesseract-ocr-eng \
    # curl for health checks
    curl \
    # Build tools
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
RUN pip install --no-cache-dir \
    flask \
    gunicorn \
    opencv-python-headless \
    numpy \
    pytesseract \
    easyocr \
    Pillow

# Note: PaddleOCR installation is large and may OOM on small servers
# Uncomment if your server has enough RAM (>4GB)
# RUN pip install --no-cache-dir paddlepaddle paddleocr

# Copy application files
COPY opencv_preprocessor.py .
COPY ensemble_ocr.py .
COPY enhanced_ocr_service.py .

# Pre-download EasyOCR models
RUN python -c "import easyocr; easyocr.Reader(['ar', 'en'], gpu=False, verbose=False)"

EXPOSE 5001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5001/health || exit 1

# Run with gunicorn
CMD ["gunicorn", "--bind", "0.0.0.0:5001", "--workers", "1", "--timeout", "600", "enhanced_ocr_service:app"]
