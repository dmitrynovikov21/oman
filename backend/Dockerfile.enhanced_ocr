# Production OCR Service (PaddleOCR + FastAPI)
FROM python:3.11-slim-bookworm

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    poppler-utils \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Create cache dirs for Paddle to avoid permission issues
RUN mkdir -p /root/.paddleocr && chmod 777 /root/.paddleocr

# Copy application files
COPY . .

EXPOSE 5001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5001/ || exit 1

# Run with uvicorn
CMD ["uvicorn", "ocr_server:app", "--host", "0.0.0.0", "--port", "5001", "--workers", "1"]
