# ExpertOS Production Environment Variables
# Copy this file to .env and fill in the values

# Database
POSTGRES_USER=expertos
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
POSTGRES_DB=expertos

# Next.js
NEXTAUTH_URL=http://193.233.233.217:3000
NEXTAUTH_SECRET=GENERATE_THIS_WITH_openssl_rand_base64_32

# Database URL (used by Prisma)
DATABASE_URL=postgresql://expertos:CHANGE_THIS_TO_SECURE_PASSWORD@db:5432/expertos

# Optional: Domain (if using nginx with domain)
# DOMAIN=expertos.example.com
